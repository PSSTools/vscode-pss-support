{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "out",
    "rootDir": "src",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
