
node_modules/
*.log
out/

# tsc -b incremental state. Rewritten by every build and tracked until now, so
# it turned up dirty in every diff and every commit -- derived state competing
# with source for review attention. Deleting it only costs one non-incremental
# rebuild.
*.tsbuildinfo

packages/
docs/_build/

# DERIVED FROM pssparser, NOT SOURCE. Both trees are produced by `npm run
# generate` from ivpm-supplied inputs: the ANTLR parser from src/PSS*.g4, the
# AST classes from ast/*.yaml.
#
# They were tracked until now, and that is what let them go stale: the parser
# sat 24 tokens behind the grammar for three weeks while CI stayed green,
# because the committed copy satisfied every consumer and nothing ever compared
# it against its source. Checking in derived output means the drift is silent;
# deriving it at build means an upstream grammar change turns CI red, which is
# the signal we want.
server/src/generated/
server/src/core/ast/generated/

.agents/
.claude/
.codex/
.cursor/

