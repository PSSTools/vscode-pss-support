{
    "name": "vscode-pss-support",
    "version": "0.0.0",
    "displayName": "VSCode Accellera PSS",
    "description": "VSCode support for the Accellera Portable Stimulus Specification (PSS) language",
    "publisher": "matthew-ballance",
    "license": "Apache 2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/psstools/vscode-pss-support"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "icon": "images/icon.png",
    "badges": [
        {
            "url": "https://dev.azure.com/mballance/psstools/_apis/build/status/PSSTools.vscode-pss-support?branchName=master",
            "href": "https://dev.azure.com/mballance/psstools/_build/latest?definitionId=21&branchName=master",
            "description": "Build Status"
        }
    ],
    "keywords": [
        "portable stimulus",
        "pss",
        "Accellera"
    ],
    "activationEvents": [
        "onLanguage:pss"
    ],
    "main": "./client/out/extension",
    "contributes": {
        "languages": [
            {
                "id": "pss",
                "aliases": [
                    "portable-stimulus",
                    "pss"
                ],
                "extensions": [
                    ".pss"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "snippets": [
            {
                "language": "pss",
                "path": "./snippets/pss.json"
            }
        ],
        "grammars": [
            {
                "language": "pss",
                "scopeName": "source.pss",
                "path": "./syntaxes/pss.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.c": "c",
                    "meta.embedded.block.sv": "systemverilog"
                }
            }
        ],
        "configuration": {
            "type": "object",
            "title": "PSS configuration",
            "properties": {
                "pss.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls maximum number of errors produced per file"
                },
                "pss.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces communication between VSCode and LSP"
                }
            }
        },
        "commands": [
            {
                "command": "pss.showActivityDiagram",
                "title": "PSS: View Activity Diagram",
                "category": "PSS"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceLangId == pss",
                    "command": "pss.showActivityDiagram",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "node scripts/check-vsix-server.mjs",
        "package:vsix": "node scripts/package-vsix.mjs",
        "bootstrap": "ivpm update -a -d default-dev -j 1 && npm install",
        "bootstrap:source": "ivpm update -a -d source-dev -j 1 && npm install && npm run use:source",
        "use:source": "cd server && npm install --no-save ../packages/pssparser/ts",
        "use:prebuilt": "cd server && npm install",
        "which:parser": "node -p \"'@psstools/pssparser ' + require('./server/node_modules/@psstools/pssparser/package.json').version + (require('fs').lstatSync('server/node_modules/@psstools/pssparser').isSymbolicLink() ? ' (source build)' : ' (prebuilt, from registry)')\"",
        "build": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "test": "npm run test:core && npm run test:lsp && npm run test:client && npm run test:contrib && npm run test:grammar",
        "test:core": "cd server && npm run test:core",
        "test:lsp": "cd server && npm run test:lsp",
        "test:package": "cd server && npm run test:package",
        "test:bench": "cd server && npm run test:bench",
        "lint": "eslint server/src/ --ext .ts",
        "postinstall": "cd client && npm install && cd ../server && npm install",
        "test:client": "cd client && npm test",
        "test:contrib": "vitest run",
        "test:grammar": "vscode-tmgrammar-test -g syntaxes/pss.tmLanguage.json \"test/grammar/*.pss\"",
        "typecheck": "cd server && npm run typecheck && cd ../client && npm run typecheck"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^8.56.0",
        "typescript": "^5.4.0",
        "vitest": "^2.1.9",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
